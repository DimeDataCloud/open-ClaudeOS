<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeOS.Shell.Views.IntentBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClaudeOS.Shell.Controls"
    xmlns:services="using:ClaudeOS.Shell.Services"
    Title="open-ClaudeOS">

    <Grid x:Name="Root" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The one input. Nothing else competes with it. -->
        <Grid Grid.Row="0" Height="64" Padding="18,0,20,0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:PresenceOrb x:Name="Orb" Width="36" Height="36" VerticalAlignment="Center" />

            <TextBox x:Name="Input"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     PlaceholderText="What do you want to do?"
                     FontFamily="{StaticResource CosFontDisplay}"
                     FontSize="{StaticResource CosSizeBar}"
                     AutomationProperties.Name="Tell the computer what you want"
                     AcceptsReturn="False"
                     IsSpellCheckEnabled="False"
                     BorderThickness="0">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>

            <TextBlock x:Name="Hint" Grid.Column="2" Style="{StaticResource CosCaptionText}" VerticalAlignment="Center" />
        </Grid>

        <!-- What Claude is really doing, in words. -->
        <Grid x:Name="StatusRow" Grid.Row="1" Visibility="Collapsed" Padding="70,0,20,12">
            <StackPanel Spacing="2">
                <TextBlock x:Name="Status" Style="{StaticResource CosBodyText}" />
                <TextBlock x:Name="StatusHint" Style="{StaticResource CosCaptionText}" />
            </StackPanel>
        </Grid>

        <ListView x:Name="Results"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  Padding="8,0,8,10">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:BarResult">
                    <Grid Height="48" ColumnSpacing="14" Padding="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="{x:Bind Glyph}" FontSize="16"
                                   Foreground="{ThemeResource CosInkSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CosBodyText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CosCaptionText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
