<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeOS.Shell.Views.ApprovalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Review">

    <!-- The approval card. Everything on it is generated from the typed actions, not from model prose. -->
    <Grid x:Name="Root" Padding="28,26,28,22" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock x:Name="Title" Style="{StaticResource CosTitleText}" TextWrapping="Wrap" />
            <TextBlock x:Name="Claim" Style="{StaticResource CosCaptionText}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Spacing="12" />
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse x:Name="RiskDot" Width="8" Height="8" VerticalAlignment="Center" />
                <TextBlock x:Name="RiskLine" Style="{StaticResource CosCaptionText}" TextWrapping="Wrap" MaxWidth="250" />
            </StackPanel>

            <Button x:Name="Decline" Grid.Column="1" Content="Not now" Style="{StaticResource CosQuietButton}"
                    AutomationProperties.Name="Decline. Nothing will change." />

            <!-- Approve: a plain press for things that stay on this PC, a deliberate hold for things that leave it. -->
            <Button x:Name="ApproveHost" Grid.Column="2" MinWidth="132" Height="38" Padding="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Style="{StaticResource CosPrimaryButton}"
                    AutomationProperties.AutomationId="Approve">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource CosAccentActionColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource CosAccentActionColor}" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource CosAccentActionColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource CosAccentActionInkColor}" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource CosAccentActionInkColor}" />
                </Button.Resources>
                <Grid>
                    <Border x:Name="HoldFill" HorizontalAlignment="Left" Width="0" Background="{ThemeResource CosAccentActionInkBrush}" Opacity="0.22" />
                    <TextBlock x:Name="ApproveText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource CosFontUi}" FontSize="{StaticResource CosSizeBody}" FontWeight="SemiBold"
                               Foreground="{ThemeResource CosAccentActionInkBrush}" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Window>
