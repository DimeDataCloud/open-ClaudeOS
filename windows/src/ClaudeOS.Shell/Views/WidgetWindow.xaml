<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeOS.Shell.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Widget">

    <!-- A widget is its content on a quiet surface. Nothing else. -->
    <Grid x:Name="Root" Background="{ThemeResource CosSurfaceRaisedBrush}" Padding="18">
        <ContentPresenter x:Name="Host" VerticalAlignment="Center" />
    </Grid>
</Window>
