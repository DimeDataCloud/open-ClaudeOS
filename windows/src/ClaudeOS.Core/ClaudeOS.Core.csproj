<Project Sdk="Microsoft.NET.Sdk">

  <!-- The portable heart of the project: no UI, no network, no SDKs. Plain .NET that runs on
       Windows, Linux and macOS, and is trim- and AOT-clean so the Native AOT shell can use it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ClaudeOS.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeOS.Core.Tests" />
  </ItemGroup>

</Project>
