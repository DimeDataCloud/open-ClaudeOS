<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CosBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CosFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource CosSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource CosLeadingBody}" />
        <Setter Property="Foreground" Value="{ThemeResource CosInkPrimaryBrush}" />
    </Style>

    <Style x:Key="CosSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource CosBodyText}">
        <Setter Property="Foreground" Value="{ThemeResource CosInkSecondaryBrush}" />
    </Style>

    <Style x:Key="CosCaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CosFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource CosSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource CosLeadingCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource CosInkTertiaryBrush}" />
    </Style>

    <Style x:Key="CosTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CosFontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource CosSizeTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource CosLeadingTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource CosInkPrimaryBrush}" />
    </Style>

    <Style x:Key="CosMonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CosFontMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource CosInkPrimaryBrush}" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The one filled button: the accent action. -->
    <Style x:Key="CosPrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource CosFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource CosSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="CornerRadius" Value="{StaticResource CosRadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource CosAccentActionBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CosAccentActionInkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Everything else is quiet: text with a hover wash. -->
    <Style x:Key="CosQuietButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource CosFontUi}" />
        <Setter Property="FontSize" Value="{StaticResource CosSizeBody}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="{StaticResource CosRadiusControl}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource CosInkSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="CosCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CosSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CosLineHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CosRadiusCard}" />
    </Style>
</ResourceDictionary>
