<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one place the official Anthropic C# SDK is referenced. Everything else talks to
       Claude through ClaudeOS.Core.Planning.IModelClient, so an SDK upgrade (it is still in
       beta) can only break this project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ClaudeOS.Claude</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.54.1" />
    <ProjectReference Include="..\ClaudeOS.Core\ClaudeOS.Core.csproj" />
  </ItemGroup>

</Project>
