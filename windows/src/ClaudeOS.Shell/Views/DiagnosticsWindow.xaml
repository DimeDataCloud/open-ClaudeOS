<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeOS.Shell.Views.DiagnosticsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClaudeOS.Shell.Controls"
    Title="Check this device">

    <Grid x:Name="Root" Padding="28,24,28,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:PresenceOrb x:Name="Orb" Width="32" Height="32" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Check this device" Style="{StaticResource CosTitleText}" />
                <TextBlock x:Name="Sub" Style="{StaticResource CosCaptionText}" Text="Measuring…" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="Report" Style="{StaticResource CosMonoText}" TextWrapping="NoWrap" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="Copy" Content="Copy report" Style="{StaticResource CosQuietButton}" />
            <Button x:Name="Done" Content="Close" Style="{StaticResource CosPrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
