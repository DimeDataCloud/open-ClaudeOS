<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeOS.Shell.Views.KeyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connect Claude">

    <Grid x:Name="Root" Padding="32,28,32,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Connect Claude" Style="{StaticResource CosTitleText}" />

        <TextBlock Grid.Row="1" Style="{StaticResource CosSecondaryText}" TextWrapping="Wrap"
                   Text="Opening files and moving windows never uses Claude. Making things, and anything that needs thinking, uses your own Anthropic API key. It is kept in Windows' per-user credential store and is never written to a file." />

        <PasswordBox x:Name="KeyBox" Grid.Row="2" PlaceholderText="sk-ant-…" AutomationProperties.Name="Anthropic API key" />

        <TextBlock x:Name="Problem" Grid.Row="3" Style="{StaticResource CosCaptionText}" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource CosStatusCriticalBrush}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="Forget" Content="Forget key" Style="{StaticResource CosQuietButton}" />
            <Button x:Name="Cancel" Content="Not now" Style="{StaticResource CosQuietButton}" />
            <Button x:Name="Save" Content="Save" Style="{StaticResource CosPrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
